OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=

# Scene names belong to the account, not to this repo. Both keys are required
# for switching: an unset OBS_ALLOWED_SCENES allows nothing, and an unset
# OBS_PRIVATE_SCENE makes obs_switch_to_private fail instead of guessing.
OBS_PRIVATE_SCENE=
OBS_ALLOWED_SCENES=

# Scene switching also requires:
# 1) OBS_SCENE_SWITCH_ENABLED=true
# 2) tool argument confirm="SWITCH_DEDUS_DEV_OBS_SCENE" (obs_switch_scene only)
OBS_SCENE_SWITCH_ENABLED=false
